# Default access token for API authentication, required when deploying to production
DEFAULT_ACCESS_TOKEN=

# Comma-separated list of allowed CORS origins (supports wildcards for subdomains)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://example.com,https://*.example.com

# Base URL for your API, for Swagger use only
API_BASE_URL=

# API keys for different AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
AI_GATEWAY_API_KEY=
LLM_GATEWAY_API_KEY=
ZAI_API_KEY=

# Base URL for Ollama (local LLM server)
OLLAMA_BASE_URL=http://localhost:11434

# Base URL for LlamaCpp (local LLM server)
LLAMACPP_BASE_URL=http://localhost:8080

# Optional: Python aibackends sidecar (see python-sidecar/)
# AIBACKENDS_ACCESS_TOKEN=          # defaults to DEFAULT_ACCESS_TOKEN
# AIBACKENDS_RUNTIME=llamacpp
# AIBACKENDS_MODEL=gemma4-e2b
# AIBACKENDS_SKIP_AUTH=false
# AIBACKENDS_SIDECAR_URL=http://localhost:8000